{
  "name": "web-network-inspector",
  "version": "0.1.0",
  "description": "An extensible in-page network waterfall with bounded local capture.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.5"
  },
  "exports": {
    ".": "./src/index.js",
    "./capture": "./src/network-capture.js",
    "./style.css": "./src/style.css",
    "./react": "./src/react.js",
    "./filters": "./src/filters.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "docs"
  ],
  "scripts": {
    "start": "node scripts/serve.mjs",
    "check": "prettier --check . && node --check src/index.js && node --check src/network-capture.js && node --check src/network-activity.js && node --check src/network-json.js && node --check src/react.js && node --check src/filters.js && node --check src/storage.js && node --check src/detail-renderer.js && node --check src/columns.js && node --check src/syntax-highlight.js",
    "test": "node --test test/*.test.js",
    "test:browser": "node --test test/browser/*.test.mjs",
    "screenshot": "node scripts/screenshot.mjs",
    "build:site": "node scripts/build-site.mjs",
    "test:site": "node --test test/site/*.test.mjs",
    "build:highlighter": "node scripts/build-highlighter.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "highlight.js": "11.11.1",
    "linkedom": "0.18.12",
    "marked": "18.1.1",
    "playwright": "1.62.1",
    "prettier": "3.6.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
